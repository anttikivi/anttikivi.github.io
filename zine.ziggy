.zine_version = "0.13.0",
.custom = {
    "display_license": false,
    "footer_logo_fmt": "logo-{}.svg",
},
.supermd = .{
    .headings_h2 = true,
},
.site = .multilingual(.{
    .host_url = "https://www.anttikivi.com",
    .assets_dir_path = "assets",
    .i18n_dir_path = "i18n",
    .layouts_dir_path = "layouts",
    .static_assets = [
        ".well-known",
        "favicon.ico",
        "robots.txt",
    ],
    .locales = [
        {
            "code": "en-GB",
            "name": "in English",
            "site_title": "Antti Kivi",
            "content_dir_path": "content/en-GB",
            "output_prefix_override": "",
        },
        {
            "code": "fi",
            "name": "suomeksi",
            "site_title": "Antti Kivi",
            "content_dir_path": "content/fi",
            "output_prefix_override": "fi",
        },
    ],
})

