.zine_version = "0.13.0",
.site = .multilingual(.{
    .host_url = "https://www.anttikivi.com",
    .assets_dir_path = "assets",
    .i18n_dir_path = "i18n",
    .layouts_dir_path = "layouts",
    .static_assets = [
        ".well-known",
        "favicon.ico",
        "publickey.asc",
    ],
    .locales = [
        {
            "code": "en-GB",
            "name": "English",
            "site_title": "Antti Kivi",
            "content_dir_path": "content/en-GB",
            "output_prefix_override": "",
        },
        {
            "code": "fi-FI",
            "name": "Suomi",
            "site_title": "Antti Kivi",
            "content_dir_path": "content/fi-FI",
            "output_prefix_override": "fi",
        },
    ],
})

