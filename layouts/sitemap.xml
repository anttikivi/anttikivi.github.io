<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <ctx :if="$site.custom.get('noindex_all').not()">
        <ctx :loop="$page.locales()">
            <ctx :loop="$loop.it.site().pages()">
                <ctx :if="$loop.it.custom.has('exclude_from_sitemap').not()">
                    <url>
                        <loc :text="$loop.it.site().host_url.addPath($loop.it.link())"></loc>
                    </url>
                </ctx>
            </ctx>
        </ctx>
    </ctx>
</urlset>
