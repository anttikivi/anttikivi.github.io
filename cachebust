#!/bin/sh

set -eu

SCRIPT_DIR="$(CDPATH= cd -P "$(dirname "$0")" && pwd)"
cd "${SCRIPT_DIR}"

bust_file() {
    target="$1"
    shift

    if [ ! -f "${target}" ]; then
        printf 'file "%s" does not exist\n' "${target}" >&2
        exit 1
    fi

    dir="${target%/*}"
    [ "${dir}" = "${target}" ] && dir="."
    base="${target##*/}"
    name="${base%.*}"
    ext="${base##*.}"
    if [ "${ext}" = "${base}" ]; then
        ext=""
    else
        ext=".${ext}"
    fi

    if command -v sha256sum >/dev/null 2>&1; then
        hash="$(sha256sum "${target}" | cut -d' ' -f1)"
    elif command -v shasum >/dev/null 2>&1; then
        hash="$(shasum -a 256 "${target}" | cut -d' ' -f1)"
    else
        printf 'sha256sum or shasum required\n' >&2
        exit 1
    fi

    new_base="${name}.${hash}${ext}"
    new_file="${dir}/${new_base}"

    if [ ! -f "${new_file}" ]; then
        cp "${target}" "${new_file}"
    fi

    for old in "${dir}/${name}".[0-9a-fA-F][0-9a-fA-F]*"${ext}"; do
        if [ -f "${old}" ] && [ "${old}" != "${new_file}" ]; then
            rm -f "${old}"
        fi
    done

    if [ -n "${ext}" ]; then
        pattern="${name}\\.[0-9a-fA-F]\\{64\\}\\${ext}"
    else
        pattern="${name}\\.[0-9a-fA-F]\\{64\\}"
    fi
    for src in "$@"; do
        if [ ! -f "${src}" ]; then
            printf 'source file "%s" does not exist; skipping\n' "${src}" >&2
            continue
        fi

        tmp="${src}.tmp.$$"

        if sed "s|${pattern}|${new_base}|g" "${src}" >"${tmp}"; then
            mv "${tmp}" "${src}"
            printf 'updated %s with %s\n' "${src}" "${new_base}"
        else
            rm -f "${tmp}"
            exit 1
        fi
    done
}

for target in assets/apple-touch-icon.png assets/icon.svg assets/opengraph-image.png assets/style.css; do
    bust_file "${target}" layouts/* layouts/**/* zine.ziggy
done
